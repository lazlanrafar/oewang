# ==========================================
# oewang API — Coolify Environment Variables
# Set the referenced KEYs once in Coolify → Shared Variables → Projects →
# oewang, then paste this block into the api app's own Environment Variables.
# ==========================================

# ── Application ───────────────────────────
NODE_ENV="{{project.NODE_ENV}}"
API_PORT="{{project.API_PORT}}"
API_BASE_URL="{{project.NEXT_PUBLIC_API_URL}}"
NEXT_PUBLIC_API_URL="{{project.NEXT_PUBLIC_API_URL}}"
NEXT_PUBLIC_APP_URL="{{project.NEXT_PUBLIC_APP_URL}}"

# ── Database ──────────────────────────────
DATABASE_URL="{{project.DATABASE_URL}}"
# DATABASE_POOL_MAX="{{project.DATABASE_POOL_MAX}}"  # optional, default 3 dev / 10 prod

# ── Auth & Security ───────────────────────
JWT_SECRET="{{project.JWT_SECRET}}"
JWT_EXPIRES_IN="{{project.JWT_EXPIRES_IN}}"
ENCRYPTION_KEY="{{project.ENCRYPTION_KEY}}"
# Optional — AT-REST key for stored secrets (integration tokens, vault).
# Falls back to ENCRYPTION_KEY when unset; set a distinct value to rotate.
# DATA_ENCRYPTION_KEY="{{project.DATA_ENCRYPTION_KEY}}"
# Gates /auth/oauth/connect so only the Next.js OAuth callback can mint a
# session. REQUIRED in practice — the endpoint returns 401 without it.
OAUTH_CONNECT_SECRET="{{project.OAUTH_CONNECT_SECRET}}"

# ── Redis ─────────────────────────────────
# Use one of the two options below:
REDIS_URL="{{project.REDIS_URL}}"
# UPSTASH_REDIS_REST_URL="{{project.UPSTASH_REDIS_REST_URL}}"
# UPSTASH_REDIS_REST_TOKEN="{{project.UPSTASH_REDIS_REST_TOKEN}}"

# ── Payment (Mayar) ───────────────────────
MAYAR_API_URL="{{project.MAYAR_API_URL}}"
MAYAR_API_KEY="{{project.MAYAR_API_KEY}}"
MAYAR_WEBHOOK_TOKEN="{{project.MAYAR_WEBHOOK_TOKEN}}"

# ── AI Sidecar (apps/ai) ──────────────────
# REQUIRED in practice — ai-sidecar-client.ts throws if AI_SERVICE_URL is
# unset, and AI_SERVICE_API_KEY (min 16 chars) must match apps/ai's value.
# Value should be the ai-service container's stable internal Docker network
# alias, e.g. http://ai-service:3004 — not the public ai.* domain.
AI_SERVICE_URL="{{project.AI_SERVICE_URL}}"
AI_SERVICE_API_KEY="{{project.AI_SERVICE_API_KEY}}"

# ── Web Push (VAPID) ──────────────────────
VAPID_PUBLIC_KEY="{{project.VAPID_PUBLIC_KEY}}"
VAPID_PRIVATE_KEY="{{project.VAPID_PRIVATE_KEY}}"
VAPID_SUBJECT="{{project.VAPID_SUBJECT}}"

# ── Email ─────────────────────────────────
RESEND_API_KEY="{{project.RESEND_API_KEY}}"

# ── Currency ──────────────────────────────
CURRENCYFREAKS_API_KEY="{{project.CURRENCYFREAKS_API_KEY}}"

# ── Telegram ──────────────────────────────
TELEGRAM_BOT_TOKEN="{{project.TELEGRAM_BOT_TOKEN}}"
TELEGRAM_WEBHOOK_SECRET="{{project.TELEGRAM_WEBHOOK_SECRET}}"

# ── Google OAuth (Login + Gmail integration fallback) ──
GOOGLE_CLIENT_ID="{{project.GOOGLE_CLIENT_ID}}"
GOOGLE_CLIENT_SECRET="{{project.GOOGLE_CLIENT_SECRET}}"

# ── Gmail Integration (optional — falls back to GOOGLE_CLIENT_ID) ──
# GOOGLE_GMAIL_CLIENT_ID="{{project.GOOGLE_GMAIL_CLIENT_ID}}"
# GOOGLE_GMAIL_CLIENT_SECRET="{{project.GOOGLE_GMAIL_CLIENT_SECRET}}"

# ── Outlook / Microsoft OAuth (optional) ──────────────
# MICROSOFT_CLIENT_ID="{{project.MICROSOFT_CLIENT_ID}}"
# MICROSOFT_CLIENT_SECRET="{{project.MICROSOFT_CLIENT_SECRET}}"

# ── S3 / Object Storage ───────────────────
BUCKET_ENDPOINT="{{project.BUCKET_ENDPOINT}}"
BUCKET_REGION="{{project.BUCKET_REGION}}"
BUCKET_ACCESS_KEY_ID="{{project.BUCKET_ACCESS_KEY_ID}}"
BUCKET_SECRET_ACCESS_KEY="{{project.BUCKET_SECRET_ACCESS_KEY}}"
BUCKET_NAME="{{project.BUCKET_NAME}}"
# Optional — public CDN domain for permanently-public assets (article
# images). Falls back to a path-style bucket URL when unset.
# BUCKET_PUBLIC_URL="{{project.BUCKET_PUBLIC_URL}}"

# ── Monitoring ────────────────────────────
# SENTRY_DSN="{{project.SENTRY_DSN}}"

# ── Logging ───────────────────────────────
LOG_LEVEL="{{project.LOG_LEVEL}}"
LOG_PRETTY="{{project.LOG_PRETTY}}"

# ── NOT needed here (belongs to apps/ai only) ─────────
# MODEL_BASE_URL, MODEL_API_KEY, AI_CHAT_MODEL, AI_VISION_MODEL,
# AI_EMBED_MODEL, GITHUB_CLIENT_ID/SECRET — see docs/ENV_VARS.md
