# ==========================================
# oewang GLOBAL — Coolify Project Shared Variables (Example)
# Copy this file to .env.global and fill in real values.
# Then set each line under Coolify → Shared Variables → Projects → oewang.
# These are referenced as {{project.VARIABLE_NAME}} in per-app env files
# (.env.api, .env.app, .env.admin, .env.website, .env.ai).
# ==========================================

# ── Application ───────────────────────────
API_PORT="3002"
NODE_ENV="production"

# ── Auth & Security ───────────────────────
JWT_SECRET=                                # min 32 chars, e.g: openssl rand -hex 32
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY=                            # exactly 32 chars, e.g: openssl rand -hex 16
DATA_ENCRYPTION_KEY=                       # optional, exactly 32 chars — falls back to ENCRYPTION_KEY when unset
# Gates /auth/oauth/connect (apps/api) — apps/app + apps/admin send this
# header when minting a session after an OAuth callback. Required in practice.
OAUTH_CONNECT_SECRET=                      # min 16 chars, e.g: openssl rand -hex 24
# Shared secret gating the apps/api <-> apps/ai round trip. Must be IDENTICAL
# on both sides. Required — endpoints fail closed if unset.
AI_SERVICE_API_KEY=                        # min 16 chars, e.g: openssl rand -hex 24

# ── Payment (Mayar) ───────────────────────
MAYAR_API_URL="https://api.mayar.id/hl/v1"
MAYAR_API_KEY=                             # From Mayar dashboard → Developer → API Key
MAYAR_WEBHOOK_TOKEN=                       # From Mayar dashboard → Developer → Webhook

# ── Model Provider (9Router) ─────────────
MODEL_BASE_URL="http://localhost:20128/v1"
MODEL_API_KEY="9router"
AI_CHAT_MODEL="coder"
AI_VISION_MODEL="coder"
AI_EMBED_MODEL="coder"

# ── Web Push (VAPID) ──────────────────────
VAPID_PUBLIC_KEY=                          # Generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                             # e.g: mailto:admin@yourdomain.com

# ── Email ─────────────────────────────────
RESEND_API_KEY=                            # From resend.com → API Keys

# ── Currency ──────────────────────────────
CURRENCYFREAKS_API_KEY=                    # From currencyfreaks.com

# ── Telegram ──────────────────────────────
TELEGRAM_BOT_TOKEN=                        # From @BotFather on Telegram
TELEGRAM_WEBHOOK_SECRET=                   # Generate: openssl rand -hex 32

# ── OAuth ─────────────────────────────────
GOOGLE_CLIENT_ID=                          # From Google Cloud Console → Credentials
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=                          # From GitHub → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_SECRET=

# ── Logging ───────────────────────────────
LOG_LEVEL="info"                           # trace | debug | info | warn | error | fatal
LOG_PRETTY="false"                         # true in dev, false in production

# ── S3-compatible Storage — public CDN domain (optional) ──────────
BUCKET_PUBLIC_URL=                         # e.g: https://cdn.yourdomain.com — falls back to a path-style bucket URL when unset

# ── Public Config (shared across Next.js frontends) ───────────────
NEXT_PUBLIC_SESSION_COOKIE_NAME="oewang-session"
NEXT_PUBLIC_TELEGRAM_BOT_USER=             # Your bot's username without @
NEXT_PUBLIC_VAPID_PUBLIC_KEY=              # Same value as VAPID_PUBLIC_KEY above
