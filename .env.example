# oewang environment
#
# Copy to .env and fill in. Every variable here is read and validated at
# startup; a missing required one stops the process rather than failing at
# first use. See docs/architecture.md#configuration.
#
# Values marked "dev default" are already set by infra/docker-compose.yml for
# the local stack, so a fresh checkout only needs the ones marked REQUIRED.

# ---------------------------------------------------------------- core

# PostgreSQL connection string. Read by apps/api only.
# apps/ai must NEVER receive this: it holds no database connection (D3).
# dev default: postgres://oewang:oewang@postgres:5432/oewang
DATABASE_URL=

# HS256 signing secret for the access token. Minimum 32 characters. REQUIRED.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Access token lifetime. Short on purpose (D38).
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime. Rotated on every use, family revoked on reuse.
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------- urls

# Base URL of the API, used by the web app server side only. The browser
# never calls it directly (D5, PLT-4).
# dev default: http://api:3002
API_URL=

# Base URL of the web app. Used for invite and password reset links.
# dev default: http://localhost:3000
APP_URL=

# Base URL of the AI service, called by the API.
# dev default: http://ai:3004
AI_SERVICE_URL=

# Base URL the AI service calls back on for tool execution and persistence.
# dev default: http://api:3002
API_INTERNAL_URL=

# Port the API listens on.
API_PORT=3002

# ------------------------------------------------- service to service

# Shared key between the API and the AI service. Compared in constant time.
# REQUIRED. Generate: openssl rand -hex 32
AI_SERVICE_API_KEY=

# How long the API waits on one AI service call. Generous: a chat turn runs
# a tool loop, and the extraction ladder has its own, shorter budget.
AI_REQUEST_TIMEOUT_SECS=60

# Requests per minute the AI service accepts per caller, and the lower
# ceiling on its handshake.
RATE_LIMIT_PER_MINUTE=600
HANDSHAKE_RATE_LIMIT_PER_MINUTE=30

# -------------------------------------------------- payload encryption

# Ed25519 private key for signing the OWE1 handshake, PKCS#8 PEM, mode 0600.
# Created automatically on first start in development (D22).
CRYPTO_SIGNING_KEY_FILE=./.secrets/owe1-signing-key.pem

# Pinned public keys, as kid:base64url pairs, comma separated. A production
# client with none refuses to start.
#
# CRYPTO_SIGNING_PUBLIC_KEYS pins the API's keys and is read by the web app;
# AI_SIGNING_PUBLIC_KEYS pins the AI service's and is read by the API. Each
# service signs its own handshake, so the two sets are different keys.
CRYPTO_SIGNING_PUBLIC_KEYS=
AI_SIGNING_PUBLIC_KEYS=

# Payload encryption. Plaintext mode is only honoured when APP_ENV is
# development and the server listens on localhost.
OWE1_ENABLED=true
APP_ENV=development

# ------------------------------------------------------------- models

# Where the model lives (D67). Leave empty to call Anthropic directly;
# point it at a gateway that speaks the Anthropic protocol to use anything
# else. The local stack defaults to 9Router on the host, which the ai
# container reaches at http://host.docker.internal:20128.
AI_BASE_URL=

# Key for whichever of the two the line above selects. REQUIRED once chat
# or extraction is wired up (M4).
AI_API_KEY=

# Model ids, as the provider or gateway names them. A gateway's aliases go
# here unchanged, so switching models is configuration, not a code change.
AI_CHAT_MODEL=claude-sonnet-5-5

# Extraction quality ladder: cheap first, escalate only on evidence (D36).
# A gateway exposing one alias can repeat it across all three; the ladder
# then still runs its passes, with the same model each time.
AI_VISION_PRIMARY=claude-haiku-5-5
AI_VISION_SECONDARY=claude-sonnet-5-5
AI_VISION_TERTIARY=claude-opus-5

# Score at which the ladder stops escalating, out of 100.
AI_QUALITY_THRESHOLD=70

# Wall-clock budget per extracted document. The receipt flow is synchronous,
# so a ladder that runs long is a spinner the user is watching.
AI_EXTRACTION_BUDGET_MS=45000

# Tool rounds per user turn.
AI_MAX_STEPS=8

# ------------------------------------------------------------ storage

# local or s3.
# dev default: s3, pointed at MinIO
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./.storage

# dev defaults: MinIO on http://minio:9000, bucket oewang-vault
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------- email

# Transactional email, for password reset (D40). REQUIRED from M1.
RESEND_API_KEY=
EMAIL_FROM=oewang <no-reply@example.com>

# -------------------------------------------------------------- rates

# Exchange rate source (D44). The keyless endpoint still answers; a key is
# only needed on the paid plans. A lookup that fails for any reason moves the
# resolution ladder down a step, so this is never load-bearing (TXN-22).
FX_API_URL=https://api.exchangerate.host
FX_ACCESS_KEY=

# How often the in-process job refreshes the rate cache. A plain interval
# rather than a cron expression: one fixed schedule does not justify a cron
# parser, and the job is idempotent, so the exact minute does not matter.
FX_REFRESH_INTERVAL=24h

# ----------------------------------------------------------- logging

RUST_LOG=oewang_server=debug,tower_http=debug,info
