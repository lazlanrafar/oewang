# ==========================================
# oewang GO WORKER (apps/worker, Go/asynq) — Coolify Environment Variables
# Set the referenced KEYs once in Coolify -> Shared Variables -> Projects ->
# oewang, then paste this block into the worker app's own Environment Variables.
# ==========================================

# ── Application ──────────────────────────
# The Go binary reads the bare PORT var (Coolify/PaaS convention), falling
# back to 3005 if unset. Coolify's "Ports exposes" must match this value.
PORT="{{project.WORKER_PORT}}"

# ── Database ─────────────────────────────
# Same Postgres instance as apps/api/apps/ai — the worker reads/writes
# transactions, wallets, categories, audit_logs, workspace_integrations,
# user_workspaces, ai_sessions, ai_messages, notifications, and the two
# retention-purge tables directly (raw pgx SQL, no ORM).
DATABASE_URL="{{project.DATABASE_URL}}"

# ── Redis ────────────────────────────────
# Must be a real TCP Redis (asynq needs BRPOP/EVAL) — same instance apps/api
# uses. Also used directly (not just via asynq) to invalidate apps/api's
# oewang:integrations:* cache key after a Telegram connect.
REDIS_URL="{{project.REDIS_URL}}"

# ── Auth & Security ──────────────────────
# Shared secret gating apps/api's internal.controller.ts; also sent as
# x-api-key when apps/api enqueues onto this worker (min 16 chars).
WORKER_API_KEY="{{project.WORKER_API_KEY}}"

# ── Telegram ─────────────────────────────
# Same bot token apps/api uses — the worker calls the Telegram Bot API
# directly (sendMessage/editMessageText/getFile/file download/sendChatAction)
# to process the full webhook state machine itself.
TELEGRAM_BOT_TOKEN="{{project.TELEGRAM_BOT_TOKEN}}"

# ── Callback to apps/api ─────────────────
# Billing/vault/invoice sweeps still call back into apps/api's internal
# endpoints. Point this at its stable internal Docker network alias, e.g.
# http://api:3002 — not the public api.* domain.
API_INTERNAL_URL="{{project.API_INTERNAL_URL}}"

# ── apps/ai sidecar ──────────────────────
# Calls /internal/quota/reset-all, /internal/anomaly/scan-all,
# /import/extract, /draft/*, /tools/execute, and /chat/stream directly — the
# worker is a third trusted x-api-key caller of apps/ai alongside apps/api
# and apps/app. Must match apps/ai's own AI_SERVICE_API_KEY exactly.
AI_SERVICE_URL="{{project.AI_SERVICE_URL}}"
AI_SERVICE_API_KEY="{{project.AI_SERVICE_API_KEY}}"

# ── Tuning (optional, sane default) ──────
# ANOMALY_SCAN_HOURS="0"                     # 0 = periodic scan disabled

# ── NOT needed here ──────────────────────
# JWT_SECRET, ENCRYPTION_KEY, MAYAR_*, BUCKET_* — the worker never verifies
# user sessions or talks to Mayar/storage directly. See docs/ENV_VARS.md
