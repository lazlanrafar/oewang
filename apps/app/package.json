{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run i18n:keys && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"i18n:keys": "bun run scripts/generate-i18n-keys.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.66.0",
		"bits-ui": "^2.20.3",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0"
	}
}
