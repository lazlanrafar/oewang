default_platform(:ios)

platform :ios do
  desc "Build and upload release to TestFlight"
  lane :ios_testflight do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      is_key_content_base64: false
    )

    create_keychain(
      name: "ci_keychain",
      password: ENV["KEYCHAIN_PASSWORD"],
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    import_certificate(
      certificate_path: "ios_distribution.p12",
      certificate_password: ENV["IOS_CERT_PASSWORD"],
      keychain_name: "ci_keychain",
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )

    install_provisioning_profile(
      path: "distribution.mobileprovision"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      profile_name: ENV["PROVISIONING_PROFILE_NAME"],
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"]
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.oewang.app" => ENV["PROVISIONING_PROFILE_NAME"]
        }
      }
    )

    upload_to_testflight(
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end
end
