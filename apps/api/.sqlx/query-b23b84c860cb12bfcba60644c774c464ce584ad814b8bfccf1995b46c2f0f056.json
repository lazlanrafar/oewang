  "query": "UPDATE wallet_groups\n           SET name = COALESCE($3, name),\n               sort_order = COALESCE($4, sort_order),\n               updated_at = now()\n           WHERE workspace_id = $1 AND id = $2 AND deleted_at IS NULL\n           RETURNING id, name, sort_order, created_at, updated_at",
