  "query": "SELECT d.id, d.token\n           FROM device_tokens d\n           JOIN user_workspaces m\n             ON m.user_id = d.user_id AND m.workspace_id = $1 AND m.deleted_at IS NULL\n           WHERE d.deleted_at IS NULL\n           ORDER BY d.created_at, d.id",
