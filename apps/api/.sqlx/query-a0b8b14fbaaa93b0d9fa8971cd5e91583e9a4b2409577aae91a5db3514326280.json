{
  "db_name": "PostgreSQL",
  "query": "SELECT w.id, w.group_id, g.name AS \"group_name?\", w.name, w.currency_code,\n                  w.balance, w.is_included_in_totals, w.is_default, w.sort_order,\n                  EXISTS(\n                    SELECT 1 FROM transactions t\n                    WHERE t.workspace_id = w.workspace_id\n                      AND (t.wallet_id = w.id OR t.to_wallet_id = w.id)\n                      AND t.deleted_at IS NULL\n                  ) AS \"has_transactions!\",\n                  w.created_at, w.updated_at\n           FROM wallets w\n           LEFT JOIN wallet_groups g\n             ON g.id = w.group_id AND g.deleted_at IS NULL\n           WHERE w.workspace_id = $1 AND w.deleted_at IS NULL\n           ORDER BY g.sort_order NULLS LAST, g.name NULLS LAST,\n                    w.sort_order, w.name",
