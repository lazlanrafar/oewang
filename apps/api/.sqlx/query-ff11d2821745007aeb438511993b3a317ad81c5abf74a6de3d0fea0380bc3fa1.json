  "query": "SELECT m.user_id, u.email, u.name, m.role, m.joined_at\n           FROM user_workspaces m\n           JOIN users u ON u.id = m.user_id\n           WHERE m.workspace_id = $1 AND m.deleted_at IS NULL\n           ORDER BY m.joined_at",
