# Development image: the toolchain lives here, not on the host.
FROM rust:1-bookworm

WORKDIR /app

# Rebuild on change, and run migrations. Both are build-time installs so the
# host needs no Rust toolchain at all.
RUN cargo install cargo-watch --locked \
 && cargo install sqlx-cli --locked --no-default-features --features postgres,rustls

# sqlx offline data is committed, so no database is needed to compile.
ENV SQLX_OFFLINE=true
ENV CARGO_TARGET_DIR=/cargo-target

EXPOSE 3002

CMD ["cargo", "watch", "-x", "run --bin oewang-api"]
