# ==========================================
# oewang AI SIDECAR (apps/ai, Python/FastAPI) — Coolify Environment Variables
# Set the referenced KEYs once in Coolify → Shared Variables → Projects →
# oewang, then paste this block into the ai-service app's own Environment Variables.
# ==========================================

# ── Application ───────────────────────────
AI_PORT="{{project.AI_PORT}}"

# ── Database ──────────────────────────────
# Same Postgres instance as apps/api — the sidecar reads/writes transactions,
# quota, and audit directly.
DATABASE_URL="{{project.DATABASE_URL}}"

# ── Auth & Security ───────────────────────
# Shared secret gating the sidecar<->api round trip. Must match apps/api's
# AI_SERVICE_API_KEY exactly (min 16 chars).
AI_SERVICE_API_KEY="{{project.AI_SERVICE_API_KEY}}"

# ── Model Provider (9Router or any OpenAI-compatible endpoint) ──
MODEL_BASE_URL="{{project.MODEL_BASE_URL}}"
MODEL_API_KEY="{{project.MODEL_API_KEY}}"
AI_CHAT_MODEL="{{project.AI_CHAT_MODEL}}"
AI_VISION_MODEL="{{project.AI_VISION_MODEL}}"
AI_EMBED_MODEL="{{project.AI_EMBED_MODEL}}"
# AI_RECEIPT_DETAIL="auto"                   # low | auto | high

# ── Callback to apps/api ──────────────────
# Tool execution + system-prompt fetch call back into apps/api. Point this at
# its stable internal Docker network alias, e.g. http://api:3002 — not the
# public api.* domain.
API_INTERNAL_URL="{{project.API_INTERNAL_URL}}"

# ── Tuning (all optional, sane defaults) ──
# AI_MAX_STEPS="10"                          # tool-loop step cap
# ALERT_CALLBACK_URL=                        # anomaly-alert webhook target
# ANOMALY_SCAN_HOURS="0"                     # 0 = periodic scan disabled
# RECEIPT_DRY_RUN="false"                    # preview receipt writes without persisting
# MOCK_AI_QUOTA="false"                      # bypass quota check — dev only, NEVER true in production

# ── NOT needed here ────────────────────────
# REDIS_URL, BUCKET_*, MAYAR_*, any OAuth client vars, SENTRY_DSN —
# this service owns only the LLM loop + its own DB access. See docs/ENV_VARS.md
