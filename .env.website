# ==========================================
# oewang WEBSITE — Coolify Environment Variables
# Set the referenced KEYs once in Coolify → Shared Variables → Projects →
# oewang, then paste this block into the website app's own Environment Variables.
# ==========================================

# ── Application ───────────────────────────
NODE_ENV="{{project.NODE_ENV}}"

# ── Auth & Security ───────────────────────
# TRANSPORT key — decrypts pricing/FAQ/article content fetched server-side
# from apps/api (lib/pricing.server.ts, faq.server.ts, articles.server.ts).
ENCRYPTION_KEY="{{project.ENCRYPTION_KEY}}"

# ── Public URLs ───────────────────────────
NEXT_PUBLIC_WEBSITE_URL="{{project.NEXT_PUBLIC_WEBSITE_URL}}"
NEXT_PUBLIC_API_URL="{{project.NEXT_PUBLIC_API_URL}}"
NEXT_PUBLIC_APP_URL="{{project.NEXT_PUBLIC_APP_URL}}"

# ── Public Config ─────────────────────────
NEXT_PUBLIC_SESSION_COOKIE_NAME="{{project.NEXT_PUBLIC_SESSION_COOKIE_NAME}}"
NEXT_PUBLIC_TELEGRAM_BOT_USER="{{project.NEXT_PUBLIC_TELEGRAM_BOT_USER}}"

# ── NOT needed here ────────────────────────
# JWT_SECRET (no auth/session on the marketing site), DATABASE_URL,
# AI_SERVICE_*, MODEL_*, MAYAR_*, BUCKET_* — see docs/ENV_VARS.md
